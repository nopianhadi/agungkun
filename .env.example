# GEMINI_API_KEY: Diperlukan untuk panggilan API Gemini AI.
# AI Studio secara otomatis menyuntikkan ini saat runtime dari rahasia pengguna.
# Pengguna mengonfigurasi ini melalui panel Secrets di UI AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL tempat applet ini di-host.
# AI Studio secara otomatis menyuntikkan ini saat runtime dengan URL layanan Cloud Run.
# Digunakan untuk tautan referensi mandiri, callback OAuth, dan endpoint API.
APP_URL="MY_APP_URL"
